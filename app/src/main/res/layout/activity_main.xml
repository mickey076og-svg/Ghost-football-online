<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.ghostfootball.game.FootballView android:id="@+id/gameView" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_gravity="bottom" android:padding="8dp">
        <Button android:id="@+id/btnPass" android:text="PASS" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp"/>
        <Button android:id="@+id/btnShoot" android:text="SHOOT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp"/>
        <Button android:id="@+id/btnSprint" android:text="SPRINT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp"/>
    </LinearLayout>
    <TextView android:id="@+id/txtRoom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF" android:textSize="16sp" android:padding="10dp"/>
</FrameLayout>
