<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:padding="24dp" android:gravity="center"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0A4B1A">
<TextView android:text="GHOST FOOTBALL ONLINE" android:textSize="28sp" android:textColor="#FFF" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnCreate" android:text="CREATE ROOM" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="30dp"/>
<TextView android:id="@+id/txtMyCode" android:text="" android:textSize="22sp" android:textColor="#FFEB3B" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp"/>
<EditText android:id="@+id/inputCode" android:hint="Enter Code e.g GHOST-4829" android:textAllCaps="true" android:layout_width="match_parent" android:layout_height="60dp" android:background="#FFFFFF" android:padding="12dp"/>
<Button android:id="@+id/btnJoin" android:text="JOIN ROOM" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="10dp"/>
<Button android:id="@+id/btnOffline" android:text="PLAY OFFLINE" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="30dp"/>
<TextView android:text="Offline = vs AI | Room = vs Friend anywhere" android:textColor="#FFF" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
